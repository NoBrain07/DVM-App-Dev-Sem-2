{
  "expo": {
    "name": "FestExp",
    "slug": "FestExp",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "festexp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "versionCode" : 10,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "FEST.Exp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMSans-Medium.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/GoogleSans-Bold.ttf",
            "./assets/fonts/GoogleSans-SemiBold.ttf",
            "./assets/fonts/GoogleSans-Italic.ttf",
            "./assets/fonts/GoogleSans-Regular.ttf",
            "./assets/fonts/GoogleSans-Medium.ttf",
            "./assets/fonts/MilordBook.ttf",
            "./assets/fonts/MilordBook-Italic.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc994342-7af6-4e28-b5fc-12f9cfa9b1ff"
      }
    }
  }
}
